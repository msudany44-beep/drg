<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:layout_marginBottom="12dp">

    <!-- Bubble for Model Spoken Response -->
    <TextView
        android:id="@+id/textMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:background="@drawable/bg_model_bubble"
        android:padding="14dp"
        android:textColor="@color/text_light"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:text="Model message" />

    <!-- Recasting & Pedagogical Feedback Card -->
    <LinearLayout
        android:id="@+id/recastCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_recast_card"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 تصحيح بديهي وملاحظة:"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textRecastCorrection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_blue_light"
            android:textSize="13sp"
            android:layout_marginTop="3dp"
            android:text="الصيغة الطبيعية: ..." />

        <TextView
            android:id="@+id/textGrammarTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="شرح القاعدة..." />
    </LinearLayout>

</LinearLayout>
